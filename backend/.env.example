# NirvanaX — Environment Variables
# Copy this file to .env and fill in your values

# ── Database ──────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/nirvanax.db
SECRET_KEY=change-this-to-a-random-secret-key

# ── AI Models ─────────────────────────────────────────────
# Gemini 2.5 Flash — Primary LLM
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Groq llama-3.1-8b-instant — Fast fallback LLM
# Get from: https://console.groq.com/keys
GROQ_API_KEY=

# Ollama — Local LLM (optional)
OLLAMA_BASE_URL=http://localhost:11434

# ── Market Data ───────────────────────────────────────────
# Groww API — Live NSE/BSE quotes (expires every 24h)
# Get from: https://groww.in → Developer Portal
GROWW_API_KEY=

# Indian Stock Market API — Financials, news, analyst views
# Get from: https://indianapi.in
INDIAN_API_KEY=

# ── Google Custom Search (optional — enables live web search) ──
# Get API key: https://console.cloud.google.com/apis/credentials
# Create engine: https://programmablesearchengine.google.com
# Enable API: https://console.cloud.google.com/apis/library/customsearch.googleapis.com
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
# Set to true after enabling Custom Search API in Google Cloud
GOOGLE_CSE_ENABLED=false
